# Copy this file to .env and fill in your own values before running
# `docker compose up`. .env is gitignored, so your values stay local.
#
# THREADBEAM_PUBLISH_ADDRESS controls which host-side interface the
# container's port is published on. Leave it unset (or set to 127.0.0.1)
# for loopback-only access. Set it to this host's exact LAN IP to make
# Threadbeam reachable from other trusted devices on the same network,
# without using Docker host networking.
#
# Threadbeam has no login. Only bind it to a network you trust -- see
# SECURITY.md.
#
# THREADBEAM_PUBLISH_ADDRESS=192.168.1.20

# THREADBEAM_PUBLISH_PORT=4317
